# ~/.custom_aliases
# Add your personal aliases here.

# --- Git ---
alias g='git'
alias ga='git add'
alias gaa='git add --all'
alias gc='git commit -m'
alias gco='git checkout'
alias gcb='git checkout -b'
alias gp='git push'
alias gl='git pull'
alias gd='git diff'
alias gb='git branch'
alias gs='git status'
alias gst='git stash'
alias glog='git log --oneline --graph --decorate'

# Amend the last commit without changing its message
alias gu='git commit --amend --no-edit'

# --- Listing ---
alias ll='ls -lah'
alias l='ls -CF'
alias la='ls -A'
alias lt='ls -lt'

# --- Navigation: each extra dot goes up one more level ---
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias ......='cd ../../../../..'
alias .......='cd ../../../../../..'
alias ........='cd ../../../../../../..'
alias ~='cd ~'
alias -- -='cd -'

# --- Quality of life ---
if [ -n "$ZSH_VERSION" ]; then
  alias reload='source ~/.zshrc'
else
  alias reload='source ~/.bashrc'
fi

# Make a directory and cd into it
mkcd() { mkdir -p "$1" && cd "$1"; }
